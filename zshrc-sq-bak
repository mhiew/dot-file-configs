# Record a perfetto trace
# takes an optional parameter for the save file name
function recordPerfettoLocal {
  local traceFileName="${1:-trace_file}"
  local currentDateTime=$(date +'%Y.%m.%d.%H.%M.%S')
  local outputSaveFile="${traceFileName}_${currentDateTime}.perfetto-trace"
  echo "Saving perfetto recording at $PWD/$outputSaveFile" 

  adb shell setprop persist.traced.enable 1

  #./record_android_trace -o $outputSaveFile -b 500mb -a com.squareup sched freq idle am wm gfx view binder_driver hal dalvik input res
  ./record_android_trace -o $outputSaveFile -c ./scripts/profiler/perfetto-config.pbtx
  #profiler --perfetto-options "-c /Users/mhiew/Development/android-register/scripts/profiler/perfetto-config.pbtx"
}

# Runs the perfetto analysis script on a trace file 
function analyzePerfetto {
  local traceFile=$1
  local traceFilePath=$(readlink -f $traceFile)
  [[ -f $traceFilePath ]] || { echo "No trace file provided. Exiting!"; return 1; }

  echo "Beginning analysis of $traceFilePath"
  ./scripts/run.analyze.perfetto.main.kts --trace_path $traceFilePath --mode ANALYZE
}

# Records Simple Perf
# takes an optional parameter for the output directory name 
function recordSimplePerf {
  local directoryName="${1:-simpleperf}"
  local currentDateTime=$(date +'%Y.%m.%d.%H.%M.%S')
  local outputDirectory="${directoryName}_${currentDateTime}"
  local fullOutputDirectory="/Users/mhiew/Desktop/$outputDirectory"
  echo "Saving simplePerf recording at $fullOutputDirectory" 

  mkdir $fullOutputDirectory
  ./scripts/simpleperf-helper.main.kts --package com.squareup --output $fullOutputDirectory 

  echo "Drag perf.trace into browser"
  open "https://profiler.firefox.com"

  echo "Opening $fullOutputDirectory"
  open $fullOutputDirectory
}

