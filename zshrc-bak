# Added by min - connect squid to charles proxy
# more info here: https://www.notion.so/sellermobile/How-to-connect-to-staging-at-home-77531b84b5474f7298b40dd3bc3ffdf1?pvs=4#9857e9dcd51b84893b38e770fb7306b0c
function adbwifi() {
  ADDR=`ifconfig | awk '/inet 192/ || /inet 10./ { print $2 }'`
  PORT=8888
  adb -d ${@} root || return 1
  adb -d ${@} shell settings put global global_http_proxy_host $ADDR
  adb -d ${@} shell settings put global global_http_proxy_port $PORT
  adb -d ${@} shell "su root sh -c \"iptables -F ; iptables -P INPUT ACCEPT ; iptables -P OUTPUT ACCEPT"\"
}

