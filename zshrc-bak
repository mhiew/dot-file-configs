# added by min - (taken from zprofile)
# this is used to switch which homebrew we're using based on our x86 or arm64 terminals
# we need to use x86 when deploying to a debug board
if [ $(arch) = "i386" ]
then
    eval "$(/usr/local/bin/brew shellenv)"

    # added by min - custom x86 configuration for python and x2b development using a debug board
    # we only want this to affect our x86 iterm
    export PYENV_ROOT=$HOME/.pyenv
    export PATH=$PYENV_ROOT/bin:$PATH
    eval "$(pyenv init --path)"
    eval "$(pyenv init -)"

else
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

### zsh changes for history
# increase history size
HISTFILE=~/.zsh_history
HISTSIZE=999999999
SAVEHIST=$HISTSIZE

# automatically append to history file instead of on shell exit
setopt INC_APPEND_HISTORY
export HISTTIMEFORMAT="[%F %T] "

# add timestamps for history
setopt EXTENDED_HISTORY

# remove duplicates
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_ALL_DUPS

# share history between tabs
setopt SHARE_HISTORY

# automatically show extended options and the last 30 items
alias history="history -E -30"
alias allhistory="history -9999999"

