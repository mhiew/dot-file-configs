" IDEAVIM CONFIGS

" SOURCE FROM .VIMRC
source ~/.vimrc

" Reload .ideavimrc
nnoremap <leader>sv :source ~/.ideavimrc<CR>

" Surround extension
set surround

" Disable s
map s <nop>

" Disable beeps
set visualbell
set noerrorbells

" Turn off numbers and relative line numbers so that intellij can handle it
" I install the relative line number plugin so that both are visible and these
" settings from vimrc conflict.
:set norelativenumber

" Easy Motion
"set easymotion

" Easy Motion Configs

" Disable AceJump so there are no conflicts with IdeaVimEasymotion
"let g:EasyMotion_override_acejump = 0

" Disable default mappings
"et g:EasyMotion_do_mapping = 0 

" Turn on case-insensitive feature
"et g:EasyMotion_smartcase = 1

" only have to type leader once instead of having to type it twice
"map <leader> <Plug>(easymotion-prefix)

" Jump to anywhere you want with minimal keystrokes, with just one key binding.
"map <leader>f <Plug>(easymotion-bd-f)

" Word motions are quite convenient
"map <leader>w <Plug>(easymotion-bd-w)
"map <leader>b <Plug>(easymotion-bd-e)

" JK motions: Line motions
"map <leader>j <Plug>(easymotion-bd-jk)
"map <leader>k <Plug>(easymotion-bd-jk)

" used after searching to jump to specific result

"map <leader>n <Plug>(easymotion-bd-n)

" shortcut to rebuild the app
nnoremap <leader>r :action CompileProject<CR>:action Run<CR>
"nnoremap <leader>r <Action>(Rerun)

" shortcut for SelectProjectInView
map <leader>b <Action>(SelectInProjectView)

" shortcut go switch focus between splitter
map <leader>= <Action>(NextSplitter)
map <leader>- <Action>(PrevSplitter)
" alternate shortcut
map <leader>l <Action>(NextSplitter)
map <leader>h <Action>(PrevSplitter)

" Errors
nmap <leader>x <Action>(GotoNextError)
nmap <leader>X <Action>(GotoPreviousError)

" Toggle tool windows
nmap <leader>z <Action>(HideAllWindows)

" Switch betwen tabs same as in tmux
nmap <C-a>h <Action>(PreviousTab)
nmap <C-a><C-h> <Action>(PreviousTab)

nmap <C-a>l <Action>(NextTab)
nmap <C-a><C-l> <Action>(NextTab)

" Jump between git changes up and down
nmap <C-a>j <Action>(VcsShowNextChangeMarker)
nmap <C-a><C-j> <Action>(VcsShowNextChangeMarker)
nmap g; <Action>(VcsShowNextChangeMarker)

nmap <C-a>k <Action>(VcsShowPrevChangeMarker)
nmap <C-a><C-k> <Action>(VcsShowPrevChangeMarker)
nmap g, <Action>(VcsShowPrevChangeMarker)
